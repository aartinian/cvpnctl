# Copy to cvpnctl.yaml and adjust. ~ is expanded to your home directory.

provider: aws                   # the only supported provider (default)

easyrsa:
  path: ~/easy-rsa              # directory that contains the easyrsa script
  pki_dir: ~/vpn-pki            # your PKI

certs:
  output_dir: ~/vpn/certs       # per-user folders and the state file live here

aws:
  region: eu-central-1
  profile: default              # optional; omit to use the default credential chain
  vpn_endpoint_id: cvpn-endpoint-0123456789abcdef0

ovpn:
  template: ~/.config/cvpnctl/base.ovpn   # see "Configure" in the README
  output_dir: ~/vpn/clients     # one <user>.ovpn per user

# Shared PKI in S3 (several admins): add this section and remove
# easyrsa.pki_dir, certs and ovpn above. See "Shared PKI in S3" in the README.
#
# store:
#   bucket: acme-vpn-pki
#   prefix: cvpnctl/          # optional
#   kms_key_id: alias/cvpnctl
#   link_hours: 24            # how long .ovpn links stay valid, 1–168
